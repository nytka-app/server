<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Npgsql.DependencyInjection" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmiPlatform.Omi\OmiPlatform.Omi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Migrations live in db/migrations so they are readable as SQL; DbUp reads them back out of
         the assembly at runtime. LogicalName fixes the resource name regardless of link depth. -->
    <EmbeddedResource Include="..\..\db\migrations\*.sql" LogicalName="OmiPlatform.Storage.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
