{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Npgsql": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=omi;Username=omi;Password=omi"
  },
  "Omi": {
    "ReconcileTrailingDays": 3,
    "PageSize": 25,
    "SpecVersion": "docs.omi.me, verified 2026-09-28"
  },
  "Ingest": {
    "ReconcileInterval": "00:05:00",
    "RetryDelay": "00:05:00",
    "MigrateOnStartup": true
  }
}
