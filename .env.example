# Copy to .env and fill in. Never commit .env.
#
# The double underscore is .NET's configuration separator: Omi__ApiKey binds to the Omi:ApiKey
# setting. Compose passes these straight through to both containers.

# ---------------------------------------------------------------------------
# Omi Developer API key
#
# Create in the Omi app: Settings -> Developer -> API Keys, scopes:
#   memories:read conversations:read
#
# Static bearer token, unlike Oura's OAuth2 flow -- it does not rotate and there is no
# authorization handshake to complete after deploying.
# ---------------------------------------------------------------------------
Omi__ApiKey=

# Earliest day the backfill asks for, yyyy-MM-dd. Omi has no data before the necklace existed, so
# unlike Oura's 2020-01-01 there is no sensible historical default -- set this to roughly when you
# started wearing it.
Omi__BackfillFrom=

# Days of already-ingested conversation history the reconcile job re-walks each cycle. Conversations
# can be edited or discarded in the Omi app after creation.
Omi__ReconcileTrailingDays=3

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_DB=omi
POSTGRES_USER=omi
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------
MCP_PORT=8089
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Container timezone. Only affects log timestamps and the worker's idea of "today" for the
# reconcile trailing window -- conversation days are keyed on Omi's own started_at.
# ---------------------------------------------------------------------------
TZ=Europe/Kyiv
