# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
#
# The double underscore is .NET's configuration separator: Nytka__Stt__Url binds to the
# Nytka:Stt:Url setting. Compose passes these straight through to the server.
#
# Required: POSTGRES_PASSWORD, Nytka__AdminToken and Nytka__Stt__Url. Every other server setting is
# optional and commented out on purpose: a variable that is set, even to the server's own default,
# locks that setting, and the app can no longer change it (Device, developer mode, Server settings).
# Uncomment a line to fix a value here. An empty value counts as unset, so it never locks anything.
#
# "Env only" marks a value the app can never change: the admin token and the API keys stay out of
# the database and the API, and the tuning values are read once at start.

# ---------------------------------------------------------------------------
# Postgres. The password goes into a connection string, so avoid ; and " in it.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Admin token, 32 characters or more, env only. The app sends it as a bearer token. It always
# works, so you cannot lock yourself out. Named tokens with a scope come from the app or the API.
#   openssl rand -hex 24
# ---------------------------------------------------------------------------
Nytka__AdminToken=

# ---------------------------------------------------------------------------
# Transcription endpoint (OpenAI-compatible, must answer response_format=verbose_json).
#   OpenAI:  https://api.openai.com/v1/audio/transcriptions, model whisper-1
#   Groq:    https://api.groq.com/openai/v1/audio/transcriptions, model whisper-large-v3-turbo
#   whisper.cpp server: http://<host>:<port>/inference, no key, no model
# The URL is required and env only. OpenAI and Groq also need the key and the model: uncomment them.
# ---------------------------------------------------------------------------
Nytka__Stt__Url=
# Env only.
# Nytka__Stt__ApiKey=
# Nytka__Stt__Model=
# auto lets the endpoint detect the language; or a language tag such as en or uk.
# Nytka__Stt__Language=auto

# ---------------------------------------------------------------------------
# Conversations and audio
# ---------------------------------------------------------------------------
# Silence that ends a conversation, hh:mm:ss, from 00:00:30 to 01:00:00.
# Nytka__Conversations__Gap=00:02:00
# Days to keep speech audio, 0 to 3650. 0 deletes it as soon as its transcript exists.
# Nytka__Audio__RetentionDays=14
# Weekly windows whose audio is dropped by capture time before transcription (the pendant records
# while the phone is away). JSON: days are ISO weekdays (1 Monday to 7 Sunday) of the start day,
# start and end are local HH:mm in Nytka__User__TimeZone; end at or before start crosses midnight.
# Nytka__Mute__Windows=[{"days":[1,2,3,4,5],"start":"09:30","end":"10:00"}]
# IANA time zone for prompts and mute windows, such as Europe/Kyiv.
# Nytka__User__TimeZone=UTC

# ---------------------------------------------------------------------------
# Language model (optional): titles, summaries, tasks and memories. Any OpenAI-compatible chat
# endpoint; the server calls <base URL>/chat/completions. Nothing runs until the base URL and the
# model are set, here or in the app.
#   OpenAI:  https://api.openai.com/v1
#   Ollama:  http://<host>:11434/v1, no key
#   LiteLLM or another gateway: its /v1 URL
# ---------------------------------------------------------------------------
# Nytka__Llm__BaseUrl=
# Env only. Leave it out for a local server.
# Nytka__Llm__ApiKey=
# Nytka__Llm__Model=
# auto writes titles, summaries and tasks in the language of the conversation; or a tag such as uk.
# Nytka__Llm__OutputLanguage=auto
# Env only. schema sends a strict json_schema; object asks for a JSON object instead, for
# endpoints that reject json_schema.
# Nytka__Llm__JsonMode=schema
# Env only. Seconds to wait for one model request.
# Nytka__Llm__TimeoutSeconds=120
# Env only. Transcript characters per request; a longer conversation goes in several requests.
# Nytka__Llm__MaxInputChars=100000
# Env only. How many days back conversations without a summary are summarized.
# Nytka__Llm__BackfillDays=7

# ---------------------------------------------------------------------------
# Memories: lasting facts about you, taken from summarized conversations. They need the language model.
# ---------------------------------------------------------------------------
# false stops extraction; the memories you have stay.
# Nytka__Memories__Enabled=true
# Your name for the model, up to 64 characters. Empty: the person wearing the pendant.
# Nytka__Memories__UserName=

# ---------------------------------------------------------------------------
# People: names for the other voices in your conversations. Needs the language model.
# ---------------------------------------------------------------------------
# true: after a summary, the model suggests names it heard for unnamed voices; nothing changes until you
# accept one. false stops new suggestions.
# Nytka__People__SuggestNames=true

# ---------------------------------------------------------------------------
# People: facts about the people you named, taken from summarized conversations. They need the language model.
# ---------------------------------------------------------------------------
# false stops extraction; the facts you have stay.
# Nytka__People__Facts=true

# ---------------------------------------------------------------------------
# Tags: proposed tags for conversations. They need the language model.
# ---------------------------------------------------------------------------
# true: with each summary the model may propose up to 3 tags, and up to 100 of the tag names you use go to
# it so it reuses them. Nothing is tagged until you accept a proposal. false stops new proposals and sends
# no tag names.
# Nytka__Tags__Suggest=true

# ---------------------------------------------------------------------------
# Calendar briefs: a short note before a meeting with someone you named, from a read-only ICS feed. It
# needs the language model. The feed's address usually carries a token, so it is read from here only;
# the app cannot show or change it. The event's title and the matched people's names go to the model.
# ---------------------------------------------------------------------------
# An http or https address of the ICS feed. Empty means no calendar.
# Nytka__Calendar__IcsUrl=
# How long before a meeting its brief is made, 5 to 240 minutes.
# Nytka__Calendar__BriefMinutes=30

# ---------------------------------------------------------------------------
# Daily digest: one summary of the day (headline, highlights, decisions, open questions), made after
# the hour below in Nytka__User__TimeZone. It needs the language model.
# ---------------------------------------------------------------------------
# true turns it on; the default is false.
# Nytka__Digest__Enabled=false
# The local hour, 0 to 23, after which the day's digest is made.
# Nytka__Digest__Hour=21

# ---------------------------------------------------------------------------
# Search. simple matches Cyrillic words exactly or by prefix; uk_hunspell adds the Ukrainian
# dictionary, once scripts/fetch-uk-dictionary.sh has fetched it (see the README).
# ---------------------------------------------------------------------------
# Nytka__Search__Dictionary=simple

# ---------------------------------------------------------------------------
# Your voice: once a voice is enrolled, Nytka fingerprints each new segment and labels the ones that
# match it as yours. Nothing is computed without an enrolled voice or the speaker model.
# ---------------------------------------------------------------------------
# false checks nothing new; stored verdicts stay.
# Nytka__Voice__Enabled=true
# Similarity, 0.1 to 0.95, at or above which a segment is yours.
# Nytka__Voice__UserThreshold=0.38
# Similarity, 0.1 to 0.95, at or above which a segment of 2 s or longer updates your voiceprint;
# never below the one above (the app's change is refused).
# Nytka__Voice__LearnThreshold=0.5
# false stops matched segments from updating your voiceprint.
# Nytka__Voice__Learn=true
# Shortest segment, 1.0 to 5.0 seconds, that is fingerprinted; shorter ones get no label from Nytka.
# Nytka__Voice__MinSegmentSeconds=1.0
# Layer 2 of People, off by default: group the voices of other people across conversations. true needs an
# enrolled voice (the app's change is refused without one) and audio retention of 1 day or more.
# Nytka__People__VoiceMatching=false
# Similarity, 0.5 to 0.95, at or above which a voice joins a group or matches a person's voiceprint.
# Nytka__People__VoiceThreshold=0.7
# The speaker model; a relative path is read from beside the binaries. The image carries it.
# Nytka__Voice__ModelPath=Models/nemo_en_titanet_small.onnx

# ---------------------------------------------------------------------------
# Host side
# ---------------------------------------------------------------------------
# 127.0.0.1 for a reverse proxy on this machine; a tailnet or LAN address to reach it over a VPN.
NYTKA_BIND=127.0.0.1
NYTKA_PORT=8080
# Pin a version such as 0.4.1 to upgrade on your own schedule.
NYTKA_VERSION=latest
